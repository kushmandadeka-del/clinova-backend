@app.route("/dashboard")
def dashboard():
    search = request.args.get("search", "")

    conn = get_db()

    if search:
        patients = conn.execute(
            "SELECT * FROM patients WHERE name LIKE ? ORDER BY created_at DESC",
            (f"%{search}%",)
        ).fetchall()
    else:
        patients = conn.execute(
            "SELECT * FROM patients ORDER BY created_at DESC"
        ).fetchall()

    conn.close()

    return render_template(
        "dashboard.html",
        patients=patients,
        search=search
    )


